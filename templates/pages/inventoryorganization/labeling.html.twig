{#
 # ---------------------------------------------------------------------
 #
 # GLPI - Gestionnaire Libre de Parc Informatique
 #
 # Inventory Organization - Labeling Configuration
 #
 # ---------------------------------------------------------------------
 #}

<div class="container-fluid">
    {# Header #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">
            <i class="ti ti-tag me-2"></i>
            {{ title }}
        </h1>
        <a href="inventoryorganization.php" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>
            {{ __('Retour au tableau de bord') }}
        </a>
    </div>

    <div class="row">
        {# Configuration Form #}
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-settings me-2"></i>
                        {{ __('Configuration de l etiquetage') }}
                    </h3>
                </div>
                <div class="card-body">
                    {% if error_message %}
                        <div class="alert alert-danger alert-dismissible mb-3" role="alert">
                            {{ error_message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ __('Close') }}"></button>
                        </div>
                    {% endif %}
                    
                    {% if success %}
                        <div class="alert alert-success alert-dismissible mb-3" role="alert">
                            <i class="ti ti-check me-2"></i>
                            {{ __('Configuration enregistree avec succes.') }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ __('Close') }}"></button>
                        </div>
                    {% endif %}
                    
                    {% if can_create %}
                        <form method="post" action="">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token_value|default(csrf_token(true)) }}">
                            <input type="hidden" name="action" value="save_config">
                            
                            <div class="mb-4">
                                <h4>{{ __('Format de l etiquette') }}</h4>
                                <p class="text-muted small">
                                    {{ __('Format recommande : UNH-FAC-BAT-TYPE-001') }}
                                </p>
                                
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label required">{{ __('Prefixe') }}</label>
                                        <input type="text" class="form-control" name="prefix" 
                                               value="{{ config.prefix }}" required
                                               pattern="[A-Za-z]{2,5}"
                                               placeholder="UNH"
                                               maxlength="5">
                                        <small class="form-hint">{{ __('2 a 5 lettres') }}</small>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">{{ __('Nombre de chiffres (padding)') }}</label>
                                        <select class="form-select" name="padding">
                                            {% for i in 1..6 %}
                                                <option value="{{ i }}" {% if config.padding == i %}selected{% endif %}>
                                                    {{ i }} {{ __('chiffres') }} ({{ '%0' ~ i ~ 'd'|format(1) }})
                                                </option>
                                            {% endfor %}
                                        </select>
                                        <small class="form-hint">{{ __('Exemple: 3 chiffres donne 001, 002, 003...') }}</small>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <h4>{{ __('Codes des types') }}</h4>
                                <p class="text-muted small">
                                    {{ __('Definir un code court pour chaque type de materiel.') }}
                                </p>
                                
                                <div class="row">
                                    {% for key, label in asset_types %}
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">{{ label }}</label>
                                            <input type="text" class="form-control" name="type_{{ key }}" 
                                                   value="{{ config.types[key]|default('') }}"
                                                   placeholder="{{ key[:3]|upper }}"
                                                   maxlength="5">
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i>
                                {{ __('Enregistrer la configuration') }}
                            </button>
                        </form>
                    {% else %}
                        <div class="alert alert-info mb-0">
                            {{ __('Vous n avez pas la permission de modifier la configuration.') }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        {# Preview Panel #}
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-eye me-2"></i>
                        {{ __('Apercu des etiquettes') }}
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        {{ __('Prochaines etiquettes disponibles par type :') }}
                    </p>
                    
                    <div class="table-responsive">
                        <table class="table table-vcenter">
                            <thead>
                                <tr>
                                    <th>{{ __('Type de materiel') }}</th>
                                    <th>{{ __('Prochaine etiquette') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for key, label in asset_types %}
                                    <tr>
                                        <td>
                                            <i class="ti ti-device-desktop text-muted me-2"></i>
                                            {{ label }}
                                        </td>
                                        <td>
                                            <code class="fs-5">{{ preview_labels[key] }}</code>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            {# Label Format Explanation #}
            <div class="card bg-azure-lt">
                <div class="card-body">
                    <h4>
                        <i class="ti ti-info-circle me-2"></i>
                        {{ __('Comment fonctionne l etiquetage') }}
                    </h4>
                    <p class="mb-3">{{ __('Le format suit la logique suivante :') }}</p>

                    <div class="mb-3">
                        <code class="fs-4">{{ config.prefix }}-FAC-BAT-TYPE-{{ '%0' ~ config.padding ~ 'd'|format(1) }}</code>
                    </div>
                    
                    <ul class="mb-0">
                        <li>{{ __('Prefixe: identifiant de l organisation (ex: UNH)') }}</li>
                        <li>{{ __('FAC: code faculte issu de l entite') }}</li>
                        <li>{{ __('BAT: code batiment issu du lieu') }}</li>
                        <li>{{ __('TYPE: code court du type de materiel (PC, MON, IMP...)') }}</li>
                        <li>{{ __('Numero: sequence automatique selon le nombre de chiffres choisi') }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
