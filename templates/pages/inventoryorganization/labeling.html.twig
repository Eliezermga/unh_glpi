{#
 # ---------------------------------------------------------------------
 #
 # GLPI - Gestionnaire Libre de Parc Informatique
 #
 # Organisation de l'Inventaire - Configuration de l'Étiquetage
 #
 # ---------------------------------------------------------------------
 #}

<div class="container-fluid">
    {# En-tête #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">
            <i class="ti ti-tag me-2"></i>
            {{ title }}
        </h1>
        <a href="inventoryorganization.php" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>
            Retour au Tableau de Bord
        </a>
    </div>

    <div class="row">
        {# Formulaire de Configuration #}
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-settings me-2"></i>
                        Configuration de l'Étiquetage
                    </h3>
                </div>
                <div class="card-body">
                    {% if error_message %}
                        <div class="alert alert-danger alert-dismissible mb-3" role="alert">
                            {{ error_message }}
                            <a class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></a>
                        </div>
                    {% endif %}
                    
                    {% if success %}
                        <div class="alert alert-success alert-dismissible mb-3" role="alert">
                            <i class="ti ti-check me-2"></i>
                            Configuration enregistrée avec succès !
                            <a class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></a>
                        </div>
                    {% endif %}
                    
                    {% if can_create %}
                        <form method="post" action="">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="action" value="save_config">
                            
                            <div class="mb-4">
                                <h4>Format de l'Étiquette</h4>
                                <p class="text-muted small">
                                    Configurez le format des étiquettes d'actifs. Exemple : UNH-PC-001
                                </p>
                                
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label required">Préfixe</label>
                                        <input type="text" class="form-control" name="prefix" 
                                               value="{{ config.prefix }}" required
                                               pattern="[A-Za-z]{2,5}"
                                               placeholder="UNH"
                                               maxlength="5">
                                        <small class="form-hint">2-5 lettres</small>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Remplissage Numérique</label>
                                        <select class="form-select" name="padding">
                                            {% for i in 1..6 %}
                                                <option value="{{ i }}" {% if config.padding == i %}selected{% endif %}>
                                                    {{ i }} chiffres ({{ '%0' ~ i ~ 'd'|format(1) }})
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <h4>Codes de Types</h4>
                                <p class="text-muted small">
                                    Définissez les codes courts pour chaque type d'actif.
                                </p>
                                
                                <div class="row">
                                    {% for key, label in asset_types %}
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">{{ label }}</label>
                                            <input type="text" class="form-control" name="type_{{ key }}" 
                                                   value="{{ config.types[key]|default('') }}"
                                                   placeholder="{{ key[:3]|upper }}"
                                                   maxlength="5">
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i>
                                Enregistrer la Configuration
                            </button>
                        </form>
                    {% else %}
                        <div class="alert alert-info mb-0">
                            Vous n'avez pas la permission de modifier la configuration.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        {# Panneau de Prévisualisation #}
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-eye me-2"></i>
                        Prévisualisation des Étiquettes
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        Prochaines étiquettes disponibles pour chaque type d'actif :
                    </p>
                    
                    <div class="table-responsive">
                        <table class="table table-vcenter">
                            <thead>
                                <tr>
                                    <th>Type d'Actif</th>
                                    <th>Prochaine Étiquette</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for key, label in asset_types %}
                                    <tr>
                                        <td>
                                            <i class="ti ti-device-desktop text-muted me-2"></i>
                                            {{ label }}
                                        </td>
                                        <td>
                                            <code class="fs-5">{{ preview_labels[key] }}</code>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            {# Explication du Format de l'Étiquette #}
            <div class="card bg-azure-lt">
                <div class="card-body">
                    <h4>
                        <i class="ti ti-info-circle me-2"></i>
                        Comment Fonctionnent les Étiquettes
                    </h4>
                    <p class="mb-3">Les étiquettes suivent ce format :</p>
                    
                    <div class="d-flex align-items-center justify-content-center mb-4">
                        <div class="text-center mx-2">
                            <div class="h1 text-primary mb-1">{{ config.prefix }}</div>
                            <small class="text-muted">Préfixe</small>
                        </div>
                        <div class="h1 text-muted mx-1">-</div>
                        <div class="text-center mx-2">
                            <div class="h1 text-success mb-1">TYPE</div>
                            <small class="text-muted">Code Type</small>
                        </div>
                        <div class="h1 text-muted mx-1">-</div>
                        <div class="text-center mx-2">
                            <div class="h1 text-info mb-1">{{ '%0' ~ config.padding ~ 'd'|format(1) }}</div>
                            <small class="text-muted">Numéro</small>
                        </div>
                    </div>
                    
                    <ul class="mb-0">
                        <li>Préfixe : Identifiant de votre organisation</li>
                        <li>Code Type : Identifie la catégorie d'actif</li>
                        <li>Numéro : Numéro séquentiel auto-incrémenté</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
