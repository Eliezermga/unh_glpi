{#
 # ---------------------------------------------------------------------
 #
 # GLPI - Gestionnaire Libre de Parc Informatique
 #
 # Inventory Organization - Entity Creation
 #
 # ---------------------------------------------------------------------
 #}

<div class="container-fluid">
    {# Header #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">
            <i class="ti ti-building me-2"></i>
            {{ title }}
        </h1>
        <a href="inventoryorganization.php" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>
            {{ __('Back to Dashboard') }}
        </a>
    </div>

    {# Error Message #}
    {% if error_message %}
        <div class="alert alert-danger alert-dismissible mb-4" role="alert">
            <div class="d-flex">
                <div>
                    <i class="ti ti-alert-circle me-2"></i>
                </div>
                <div>{{ error_message }}</div>
            </div>
            <a class="btn-close" data-bs-dismiss="alert" aria-label="{{ __('Close') }}"></a>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-8">
            {# Option 1: Native GLPI Form (Recommended) #}
            <div class="card mb-4">
                <div class="card-header bg-primary-lt">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-plus me-2"></i>
                        {{ __('Create a New Entity') }}
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        {{ __('Use the standard GLPI form to create an entity with all available fields.') }}
                    </p>
                    <a href="entity.form.php" class="btn btn-primary btn-lg">
                        <i class="ti ti-building-community me-2"></i>
                        {{ __('Open Creation Form') }}
                    </a>
                </div>
            </div>

            {# Navigation Shortcuts #}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-external-link me-2"></i>
                        {{ __('Quick Access') }}
                    </h3>
                </div>
                <div class="list-group list-group-flush">
                    <a href="entity.php" class="list-group-item list-group-item-action d-flex align-items-center">
                        <span class="avatar bg-info-lt me-3">
                            <i class="ti ti-list text-info"></i>
                        </span>
                        <div class="flex-fill">
                            <strong>{{ __('Entity List') }}</strong>
                            <p class="text-muted mb-0 small">{{ __('View all existing GLPI entities') }}</p>
                        </div>
                        <i class="ti ti-chevron-right"></i>
                    </a>
                    
                    <a href="inventoryorganization.location.php" class="list-group-item list-group-item-action d-flex align-items-center">
                        <span class="avatar bg-success-lt me-3">
                            <i class="ti ti-map-pin text-success"></i>
                        </span>
                        <div class="flex-fill">
                            <strong>{{ __('Manage Locations') }}</strong>
                            <p class="text-muted mb-0 small">{{ __('Create and organize locations within entities') }}</p>
                        </div>
                        <i class="ti ti-chevron-right"></i>
                    </a>
                    
                    <a href="inventoryorganization.type.php" class="list-group-item list-group-item-action d-flex align-items-center">
                        <span class="avatar bg-warning-lt me-3">
                            <i class="ti ti-devices text-warning"></i>
                        </span>
                        <div class="flex-fill">
                            <strong>{{ __('Equipment Types') }}</strong>
                            <p class="text-muted mb-0 small">{{ __('Manage equipment categories') }}</p>
                        </div>
                        <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            {# Quick Guide #}
            <div class="card bg-azure-lt">
                <div class="card-body">
                    <h4 class="mb-3">
                        <i class="ti ti-bulb me-2"></i>
                        {{ __('Quick Guide') }}
                    </h4>
                    <p class="mb-2"><strong>{{ __('What is an entity?') }}</strong></p>
                    <p class="text-muted mb-3">
                        {{ __('Entities are organizational units that allow you to segment your IT assets (by department, site, subsidiary, etc.).') }}
                    </p>
                    
                    <p class="mb-2"><strong>{{ __('Entity Hierarchy') }}</strong></p>
                    <ul class="text-muted mb-3">
                        <li>{{ __('First create the root entity (e.g., UNH)') }}</li>
                        <li>{{ __('Then add sub-entities (e.g., Campus, Departments)') }}</li>
                        <li>{{ __('Permissions are inherited in the tree structure') }}</li>
                    </ul>
                    
                    <p class="mb-2"><strong>{{ __('Best Practices') }}</strong></p>
                    <ul class="text-muted mb-0">
                        <li>{{ __('Use explicit names') }}</li>
                        <li>{{ __('Limit the number of levels (3-4 max)') }}</li>
                        <li>{{ __('Align the structure with your organization') }}</li>
                    </ul>
                </div>
            </div>
            
            {# Existing Entities #}
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">{{ __('Existing Entities') }}</h3>
                    <span class="badge bg-primary">{{ entities|length }}</span>
                </div>
                <div class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                    {% if entities|length > 0 %}
                        {% for entity in entities|slice(0, 15) %}
                            <div class="list-group-item py-2">
                                <i class="ti ti-building me-2 text-muted"></i>
                                {{ entity.name|raw }}
                            </div>
                        {% endfor %}
                        {% if entities|length > 15 %}
                            <div class="list-group-item text-muted py-2">
                                <i class="ti ti-dots me-2"></i>
                                ... {{ __('and %d more')|format(entities|length - 15) }}
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="list-group-item text-muted">
                            <i class="ti ti-info-circle me-2"></i>
                            {{ __('No entities yet') }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
