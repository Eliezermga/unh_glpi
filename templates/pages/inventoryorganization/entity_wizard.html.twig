{#
 # ---------------------------------------------------------------------
 #
 # GLPI - Gestionnaire Libre de Parc Informatique
 #
 # Inventory Organization - Entity Creation
 #
 # ---------------------------------------------------------------------
 #}

<div class="container-fluid">
    {# Header #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">
            <i class="ti ti-building me-2"></i>
            {{ title }}
        </h1>
        <a href="inventoryorganization.php" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>
            {{ __('Retour au tableau de bord') }}
        </a>
    </div>

    {% if success %}
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            <div class="d-flex">
                <div>
                    <i class="ti ti-check me-2"></i>
                </div>
                <div>{{ __('Entite creee avec succes.') }}</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ __('Close') }}"></button>
        </div>
    {% endif %}

    {# Error Message #}
    {% if error_message %}
        <div class="alert alert-danger alert-dismissible mb-4" role="alert">
            <div class="d-flex">
                <div>
                    <i class="ti ti-alert-circle me-2"></i>
                </div>
                <div>{{ error_message }}</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ __('Close') }}"></button>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-8">
            {# Inline creation form #}
            <div class="card mb-4">
                <div class="card-header bg-primary-lt">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-plus me-2"></i>
                        {{ __('Creer une nouvelle entite') }}
                    </h3>
                </div>
                <div class="card-body">
                    {% if can_create %}
                        <form method="post" action="">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token_value|default(csrf_token(true)) }}">
                            <input type="hidden" name="action" value="create_entity">

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label required">{{ __('Nom de l entite') }}</label>
                                    <input type="text" class="form-control" name="name" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">{{ __('Entite parente') }}</label>
                                    <select class="form-select" name="parent_id">
                                        {% for entity in entities %}
                                            <option value="{{ entity.id }}" {% if entity.id == active_entity %}selected{% endif %}>
                                                {% set depth = entity.level|default(0) %}
                                                {% if depth > 0 %}{% for _ in 1..depth %}— {% endfor %}{% endif %}{{ entity.name }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">{{ __('Adresse') }}</label>
                                    <input type="text" class="form-control" name="address">
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">{{ __('Code postal') }}</label>
                                    <input type="text" class="form-control" name="postcode">
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">{{ __('Ville') }}</label>
                                    <input type="text" class="form-control" name="town">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">{{ __('Pays') }}</label>
                                <input type="text" class="form-control" name="country">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">{{ __('Commentaire') }}</label>
                                <textarea class="form-control" name="comment" rows="2"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i>
                                {{ __('Creer l entite') }}
                            </button>
                        </form>
                    {% else %}
                        <div class="alert alert-info mb-0">
                            {{ __('Vous n avez pas les droits pour creer une entite.') }}
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Navigation Shortcuts #}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-external-link me-2"></i>
                        {{ __('Acces rapide') }}
                    </h3>
                </div>
                <div class="list-group list-group-flush">
                    <a href="entity.php" class="list-group-item list-group-item-action d-flex align-items-center">
                        <span class="avatar bg-info-lt me-3">
                            <i class="ti ti-list text-info"></i>
                        </span>
                        <div class="flex-fill" style="min-width: 0;">
                            <strong class="d-block">{{ __('Liste des entites') }}</strong>
                            <p class="text-muted mb-0 small" style="white-space: normal; word-break: normal;">
                                {{ __('Voir toutes les entites existantes') }}
                            </p>
                        </div>
                        <i class="ti ti-chevron-right"></i>
                    </a>
                    
                    <a href="inventoryorganization.location.php" class="list-group-item list-group-item-action d-flex align-items-center">
                        <span class="avatar bg-success-lt me-3">
                            <i class="ti ti-map-pin text-success"></i>
                        </span>
                        <div class="flex-fill" style="min-width: 0;">
                            <strong class="d-block">{{ __('Gestion des lieux') }}</strong>
                            <p class="text-muted mb-0 small" style="white-space: normal; word-break: normal;">
                                {{ __('Creer et organiser les lieux dans les entites') }}
                            </p>
                        </div>
                        <i class="ti ti-chevron-right"></i>
                    </a>
                    
                    <a href="inventoryorganization.type.php" class="list-group-item list-group-item-action d-flex align-items-center">
                        <span class="avatar bg-warning-lt me-3">
                            <i class="ti ti-devices text-warning"></i>
                        </span>
                        <div class="flex-fill" style="min-width: 0;">
                            <strong class="d-block">{{ __('Types de materiel') }}</strong>
                            <p class="text-muted mb-0 small" style="white-space: normal; word-break: normal;">
                                {{ __('Gerer les categories de materiel') }}
                            </p>
                        </div>
                        <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            {# Quick Guide #}
            <div class="card bg-azure-lt">
                <div class="card-body">
                    <h4 class="mb-3">
                        <i class="ti ti-bulb me-2"></i>
                        {{ __('Guide rapide') }}
                    </h4>
                    <p class="mb-2"><strong>{{ __('Qu est ce qu une entite ?') }}</strong></p>
                    <p class="text-muted mb-3">
                        {{ __('Les entites permettent de structurer le parc IT par faculte, departement ou site.') }}
                    </p>
                    
                    <p class="mb-2"><strong>{{ __('Hierarchie recommandee') }}</strong></p>
                    <ul class="text-muted mb-3">
                        <li>{{ __('UNH > Faculte > Departement') }}</li>
                        <li>{{ __('Definir les droits au bon niveau') }}</li>
                        <li>{{ __('Garder des noms courts et explicites') }}</li>
                    </ul>
                    
                    <p class="mb-2"><strong>{{ __('Bonnes pratiques') }}</strong></p>
                    <ul class="text-muted mb-0">
                        <li>{{ __('Eviter les doublons de nom') }}</li>
                        <li>{{ __('Limiter la profondeur de l arborescence') }}</li>
                        <li>{{ __('Verifier les droits apres creation') }}</li>
                    </ul>
                </div>
            </div>
            
            {# Existing Entities #}
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">{{ __('Entites existantes') }}</h3>
                    <span class="badge bg-primary">{{ entities|length }}</span>
                </div>
                <div class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                    {% if entities|length > 0 %}
                        {% for entity in entities|slice(0, 15) %}
                            <div class="list-group-item py-2">
                                <i class="ti ti-building me-2 text-muted"></i>
                                {% set depth = entity.level|default(0) %}
                                {% if depth > 0 %}{% for _ in 1..depth %}— {% endfor %}{% endif %}{{ entity.name }}
                            </div>
                        {% endfor %}
                        {% if entities|length > 15 %}
                            <div class="list-group-item text-muted py-2">
                                <i class="ti ti-dots me-2"></i>
                                ... {{ __('et %d de plus')|format(entities|length - 15) }}
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="list-group-item text-muted">
                            <i class="ti ti-info-circle me-2"></i>
                            {{ __('Aucune entite pour le moment') }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
