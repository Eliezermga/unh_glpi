{#
 # ---------------------------------------------------------------------
 #
 # GLPI - Gestionnaire Libre de Parc Informatique
 #
 # Inventory Organization - Location Management
 #
 # ---------------------------------------------------------------------
 #}

<div class="container-fluid">
    {# Header #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">
            <i class="ti ti-map-pin me-2"></i>
            {{ title }}
        </h1>
        <a href="inventoryorganization.php" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>
            {{ __('Back to Dashboard') }}
        </a>
    </div>

    {# Success Message #}
    {% if success %}
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            <div class="d-flex">
                <div>
                    <i class="ti ti-check me-2"></i>
                </div>
                <div>{{ __('Location created successfully!') }}</div>
            </div>
            <a class="btn-close" data-bs-dismiss="alert" aria-label="{{ __('Close') }}"></a>
        </div>
    {% endif %}

    {# Error Message #}
    {% if error_message %}
        <div class="alert alert-danger alert-dismissible mb-4" role="alert">
            <div class="d-flex">
                <div>
                    <i class="ti ti-alert-circle me-2"></i>
                </div>
                <div>{{ error_message }}</div>
            </div>
            <a class="btn-close" data-bs-dismiss="alert" aria-label="{{ __('Close') }}"></a>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-8">
            {# Option: Native GLPI Form #}
            <div class="card mb-4">
                <div class="card-header bg-success-lt">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-plus me-2"></i>
                        {{ __('Create a New Location') }}
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        {{ __('Use the standard GLPI form to create a location with building, room, GPS coordinates and other fields.') }}
                    </p>
                    <a href="location.form.php" class="btn btn-success btn-lg">
                        <i class="ti ti-map-pin me-2"></i>
                        {{ __('Open Creation Form') }}
                    </a>
                </div>
            </div>

            {# Quick Templates #}
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-template me-2"></i>
                        {{ __('Structure Suggestions') }}
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">{{ __('Here is a typical location structure for a university:') }}</p>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-3">
                                    <i class="ti ti-building-castle text-primary" style="font-size: 24px;"></i>
                                    <h5 class="mb-1">{{ __('Campus') }}</h5>
                                    <small class="text-muted">{{ __('Main geographical site') }}</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-3">
                                    <i class="ti ti-building text-info" style="font-size: 24px;"></i>
                                    <h5 class="mb-1">{{ __('Buildings') }}</h5>
                                    <small class="text-muted">{{ __('Building A, B, C, Library') }}</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-3">
                                    <i class="ti ti-door text-success" style="font-size: 24px;"></i>
                                    <h5 class="mb-1">{{ __('Rooms') }}</h5>
                                    <small class="text-muted">{{ __('Office 101, Server Room') }}</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Existing Locations List #}
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-list me-2"></i>
                        {{ __('Existing Locations') }}
                    </h3>
                    <a href="location.php" class="btn btn-sm btn-outline-primary">
                        {{ __('View All') }}
                        <i class="ti ti-external-link ms-1"></i>
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>{{ __('Name') }}</th>
                                <th class="text-end">{{ __('Assets') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if flat_locations|length > 0 %}
                                {% for location in flat_locations|slice(0, 15) %}
                                    <tr>
                                        <td>
                                            <i class="ti ti-map-pin me-2 text-success"></i>
                                            {{ location.name|raw }}
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-secondary">{{ location.asset_count }}</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                                {% if flat_locations|length > 15 %}
                                    <tr>
                                        <td colspan="2" class="text-muted text-center">
                                            ... {{ __('and %d more locations')|format(flat_locations|length - 15) }}
                                        </td>
                                    </tr>
                                {% endif %}
                            {% else %}
                                <tr>
                                    <td colspan="2" class="text-muted text-center py-4">
                                        <i class="ti ti-map-pin-off me-2"></i>
                                        {{ __('No locations defined yet') }}
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            {# Quick Guide #}
            <div class="card bg-azure-lt">
                <div class="card-body">
                    <h4 class="mb-3">
                        <i class="ti ti-bulb me-2"></i>
                        {{ __('Quick Guide') }}
                    </h4>
                    <p class="mb-2"><strong>{{ __('What is a location?') }}</strong></p>
                    <p class="text-muted mb-3">
                        {{ __('Locations allow you to geographically locate your equipment: campuses, buildings, offices, server rooms, etc.') }}
                    </p>
                    
                    <p class="mb-2"><strong>{{ __('Best Practices') }}</strong></p>
                    <ul class="text-muted mb-0">
                        <li>{{ __('Hierarchical structure: Campus → Building → Floor → Room') }}</li>
                        <li>{{ __('Use consistent codes (e.g., BLDG-A, B101)') }}</li>
                        <li>{{ __('Fill in GPS coordinates if available') }}</li>
                        <li>{{ __('Associate each equipment to a specific location') }}</li>
                    </ul>
                </div>
            </div>
            
            {# Statistics #}
            <div class="card mt-3">
                <div class="card-body text-center">
                    <div class="h1 mb-0">{{ flat_locations|length }}</div>
                    <div class="text-muted">{{ __('Defined locations') }}</div>
                </div>
            </div>
            
            {# Quick Links #}
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">{{ __('Quick Access') }}</h3>
                </div>
                <div class="list-group list-group-flush">
                    <a href="location.php" class="list-group-item list-group-item-action">
                        <i class="ti ti-list me-2"></i>
                        {{ __('Full location list') }}
                    </a>
                    <a href="inventoryorganization.entity.php" class="list-group-item list-group-item-action">
                        <i class="ti ti-building me-2"></i>
                        {{ __('Manage entities') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
