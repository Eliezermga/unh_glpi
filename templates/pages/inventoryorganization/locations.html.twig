<div class="container-fluid">
    {# En-tête #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">
            <i class="ti ti-map-pin me-2"></i>
            {{ title }}
        </h1>
        <a href="inventoryorganization.php" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>
            Retour au Tableau de Bord
        </a>
    </div>

    {# Message de Succès #}
    {% if success %}
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            <div class="d-flex">
                <div>
                    <i class="ti ti-check me-2"></i>
                </div>
                <div>Lieu créé avec succès !</div>
            </div>
            <a class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></a>
        </div>
    {% endif %}

    {# Message d'Erreur #}
    {% if error_message %}
        <div class="alert alert-danger alert-dismissible mb-4" role="alert">
            <div class="d-flex">
                <div>
                    <i class="ti ti-alert-circle me-2"></i>
                </div>
                <div>{{ error_message }}</div>
            </div>
            <a class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></a>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-8">
            {# Option: Formulaire GLPI Natif #}
            <div class="card mb-4">
                <div class="card-header bg-success-lt">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-plus me-2"></i>
                        Créer un Nouveau Lieu
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        Utilisez le formulaire GLPI standard pour créer un lieu avec bâtiment, salle, coordonnées GPS et autres champs.
                    </p>
                    <a href="location.form.php" class="btn btn-success btn-lg">
                        <i class="ti ti-map-pin me-2"></i>
                        Ouvrir le Formulaire de Création
                    </a>
                </div>
            </div>

            {# Modèles Rapides #}
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-template me-2"></i>
                        Suggestions de Structure
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Voici une structure de lieux typique pour une université :</p>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-3">
                                    <i class="ti ti-building-castle text-primary" style="font-size: 24px;"></i>
                                    <h5 class="mb-1">Campus</h5>
                                    <small class="text-muted">Site géographique principal</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-3">
                                    <i class="ti ti-building text-info" style="font-size: 24px;"></i>
                                    <h5 class="mb-1">Bâtiments</h5>
                                    <small class="text-muted">Bât. A, B, C, Bibliothèque</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-3">
                                    <i class="ti ti-door text-success" style="font-size: 24px;"></i>
                                    <h5 class="mb-1">Salles</h5>
                                    <small class="text-muted">Bureau 101, Salle Serveur</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Liste des Lieux Existants #}
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-list me-2"></i>
                        Lieux Existants
                    </h3>
                    <a href="location.php" class="btn btn-sm btn-outline-primary">
                        Voir Tout
                        <i class="ti ti-external-link ms-1"></i>
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th class="text-end">Actifs</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if flat_locations|length > 0 %}
                                {% for location in flat_locations|slice(0, 15) %}
                                    <tr>
                                        <td>
                                            <i class="ti ti-map-pin me-2 text-success"></i>
                                            {{ location.name|raw }}
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-secondary">{{ location.asset_count }}</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                                {% if flat_locations|length > 15 %}
                                    <tr>
                                        <td colspan="2" class="text-muted text-center">
                                            ... et {{ flat_locations|length - 15 }} autres lieux
                                        </td>
                                    </tr>
                                {% endif %}
                            {% else %}
                                <tr>
                                    <td colspan="2" class="text-muted text-center py-4">
                                        <i class="ti ti-map-pin-off me-2"></i>
                                        Aucun lieu défini pour le moment
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            {# Guide Rapide #}
            <div class="card bg-azure-lt">
                <div class="card-body">
                    <h4 class="mb-3">
                        <i class="ti ti-bulb me-2"></i>
                        Guide Rapide
                    </h4>
                    <p class="mb-2"><strong>Qu'est-ce qu'un lieu ?</strong></p>
                    <p class="text-muted mb-3">
                        Les lieux permettent de localiser géographiquement vos équipements : campus, bâtiments, bureaux, salles serveur, etc.
                    </p>
                    
                    <p class="mb-2"><strong>Bonnes Pratiques</strong></p>
                    <ul class="text-muted mb-0">
                        <li>Structure hiérarchique : Campus → Bâtiment → Étage → Salle</li>
                        <li>Utilisez des codes cohérents (ex: BAT-A, B101)</li>
                        <li>Renseignez les coordonnées GPS si disponibles</li>
                        <li>Associez chaque équipement à un lieu précis</li>
                    </ul>
                </div>
            </div>
            
            {# Statistiques #}
            <div class="card mt-3">
                <div class="card-body text-center">
                    <div class="h1 mb-0">{{ flat_locations|length }}</div>
                    <div class="text-muted">Lieux définis</div>
                </div>
            </div>
            
            {# Liens Rapides #}
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">Accès Rapides</h3>
                </div>
                <div class="list-group list-group-flush">
                    <a href="location.php" class="list-group-item list-group-item-action">
                        <i class="ti ti-list me-2"></i>
                        Liste complète des lieux
                    </a>
                    <a href="inventoryorganization.entity.php" class="list-group-item list-group-item-action">
                        <i class="ti ti-building me-2"></i>
                        Gérer les entités
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
