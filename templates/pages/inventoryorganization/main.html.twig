<div class="container-fluid">
    {# En-tête #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="ti ti-building-warehouse me-2"></i>
            {{ title }}
        </h1>
    </div>

    {# Cartes de Statistiques #}
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card card-sm bg-primary-lt">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="stamp bg-primary me-3">
                            <i class="ti ti-building"></i>
                        </span>
                        <div>
                            <div class="h1 mb-0">{{ stats.entities }}</div>
                            <div class="text-muted">Entités</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card card-sm bg-success-lt">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="stamp bg-success me-3">
                            <i class="ti ti-map-pin"></i>
                        </span>
                        <div>
                            <div class="h1 mb-0">{{ stats.locations }}</div>
                            <div class="text-muted">Lieux</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card card-sm bg-info-lt">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="stamp bg-info me-3">
                            <i class="ti ti-device-desktop"></i>
                        </span>
                        <div>
                            <div class="h1 mb-0">{{ stats.computers }}</div>
                            <div class="text-muted">Ordinateurs</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card card-sm bg-warning-lt">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="stamp bg-warning me-3">
                            <i class="ti ti-printer"></i>
                        </span>
                        <div>
                            <div class="h1 mb-0">{{ stats.printers }}</div>
                            <div class="text-muted">Imprimantes</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card card-sm bg-secondary-lt">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="stamp bg-secondary me-3">
                            <i class="ti ti-package"></i>
                        </span>
                        <div>
                            <div class="h1 mb-0">{{ stats.total_assets }}</div>
                            <div class="text-muted">Total Actifs</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card card-sm {% if issue_summary.total > 0 %}bg-danger-lt{% else %}bg-success-lt{% endif %}">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="stamp {% if issue_summary.total > 0 %}bg-danger{% else %}bg-success{% endif %} me-3">
                            <i class="ti ti-alert-triangle"></i>
                        </span>
                        <div>
                            <div class="h1 mb-0">{{ issue_summary.total }}</div>
                            <div class="text-muted">Problèmes</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Actions Rapides - Menu #}
    <h3 class="mb-3">
        <i class="ti ti-rocket me-2"></i>
        Actions Rapides
    </h3>
    <div class="row mb-4">
        {% for item in menu_items %}
            <div class="col-md-4 col-lg-2 mb-3">
                <a href="{{ item.link }}" class="card card-link h-100" style="text-decoration: none;">
                    <div class="card-body text-center d-flex flex-column align-items-center" style="min-width: 0;">
                        <span class="avatar avatar-lg mb-3 bg-{{ item.color }}-lt">
                            <i class="{{ item.icon }} text-{{ item.color }}"></i>
                        </span>
                        <h4 class="mb-1" style="width: 100%;">{{ item.title }}</h4>
                        <p class="text-muted small mb-0" style="width: 100%; word-wrap: break-word;">{{ item.description }}</p>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>


    {# Problèmes Récents #}
    {% if issues|length > 0 %}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-alert-circle me-2"></i>
                    Problèmes de Cohérence Récents
                </h3>
                <div class="card-actions">
                    <a href="inventoryorganization.coherence.php" class="btn btn-outline-primary btn-sm">
                        Voir Tout
                        <i class="ti ti-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Sévérité</th>
                            <th>Message</th>
                            <th>Type d'Actif</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for issue in issues|slice(0, 5) %}
                            <tr>
                                <td>
                                    {% if issue.severity == 'error' %}
                                        <span class="badge bg-danger">Erreur</span>
                                    {% elseif issue.severity == 'warning' %}
                                        <span class="badge bg-warning">Avertissement</span>
                                    {% else %}
                                        <span class="badge bg-info">Info</span>
                                    {% endif %}
                                </td>
                                <td>{{ issue.message|raw }}</td>
                                <td>{{ issue.asset_type|default('-') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="card bg-success-lt">
            <div class="card-body text-center py-5">
                <span class="avatar avatar-xl mb-3 bg-success">
                    <i class="ti ti-check"></i>
                </span>
                <h3>Tout est en ordre !</h3>
                <p class="text-muted mb-0">Aucun problème de cohérence détecté dans votre inventaire.</p>
            </div>
        </div>
    {% endif %}
</div>
