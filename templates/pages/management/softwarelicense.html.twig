{#
 # GLPI - Formulaire Licence Logiciel
 # Université Nouveaux Horizons (UNH)
#}

{% extends "generic_show_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set params = params ?? [] %}

{# ID entité UNH #}
{% set UNH_ENTITY_ID = 3 %}

{% block form_fields %}

<input type="hidden" name="entities_id" value="{{ UNH_ENTITY_ID }}"/>

<div class="alert alert-info mb-3">
   <strong>Université Nouveaux Horizons</strong><br>
   Gestion institutionnelle des licences logicielles
</div>

{# ================= LOGICIEL ================= #}
{% if item.fields['id'] > 0 %}

   <input type="hidden" name="softwares_id" value="{{ item.fields['softwares_id'] }}" />

   {% set software_link %}
      <a href="{{ call('Software::getFormURLWithID', [item.fields['softwares_id']]) }}">
         {{ call('Dropdown::getDropdownName', ['glpi_softwares', item.fields['softwares_id']]) }}
      </a>
   {% endset %}

   {{ fields.field('software', software_link, __('Logiciel')) }}

{% else %}

   {{ fields.dropdownField(
      'Software',
      'softwares_id',
      item.fields['softwares_id'],
      __('Logiciel'),
      {
         'entity': UNH_ENTITY_ID,
         'condition': {'is_deleted': 0},
         'on_change': 'this.form.submit()'
      }
   ) }}

{% endif %}

{{ fields.nullField() }}

{# ================= TYPE DE LICENCE ================= #}
{{ fields.dropdownField(
   'SoftwareLicenseType',
   'softwarelicensetypes_id',
   item.fields['softwarelicensetypes_id'],
   __('Type de licence'),
   {'entity': UNH_ENTITY_ID}
) }}

{# ================= FOURNISSEUR ================= #}
{{ fields.dropdownField(
   'Supplier',
   'suppliers_id',
   item.fields['suppliers_id'],
   __('Fournisseur'),
   {'entity': UNH_ENTITY_ID}
) }}

{# ================= LOCALISATION ================= #}
{{ fields.dropdownField(
   'Location',
   'locations_id',
   item.fields['locations_id'],
   __('Faculté / Service'),
   {'entity': UNH_ENTITY_ID}
) }}

{{ parent() }}
{% endblock %}

{% block more_fields %}

{# ================= VERSION UTILISÉE ================= #}
{% set field %}
   {% do call('SoftwareVersion::dropdownForOneSoftware', [{
      'name': 'softwareversions_id_use',
      'softwares_id': item.fields['softwares_id'],
      'value': item.fields['softwareversions_id_use'],
      'width': '100%'
   }]) %}
{% endset %}
{{ fields.field('softwareversions_id_use', field, __('Version utilisée à l’UNH')) }}

{# ================= VERSION ACHETÉE ================= #}
{% set field %}
   {% do call('SoftwareVersion::dropdownForOneSoftware', [{
      'name': 'softwareversions_id_buy',
      'softwares_id': item.fields['softwares_id'],
      'value': item.fields['softwareversions_id_buy'],
      'width': '100%'
   }]) %}
{% endset %}
{{ fields.field('softwareversions_id_buy', field, __('Version achetée')) }}

{# ================= QUANTITÉ ================= #}
{{ fields.dropdownNumberField(
   'number',
   item.fields['number'],
   __('Nombre de licences'),
   {
      'min': 1,
      'max': 10000,
      'step': 1,
      'toadd': {'-1': __('Illimité')}
   }
) }}

{# ================= DÉPASSEMENT ================= #}
{{ fields.dropdownYesNo(
   'allow_overquota',
   item.fields['allow_overquota'],
   __('Autoriser le dépassement')
) }}

{# ================= RESPONSABLE ================= #}
{{ fields.dropdownField(
   'User',
   'users_id_tech',
   item.fields['users_id_tech'],
   __('Responsable IT'),
   {'entity': UNH_ENTITY_ID}
) }}

{# ================= GROUPE IT ================= #}
{{ fields.dropdownField(
   'Group',
   'groups_id',
   item.fields['groups_id'],
   __('Service informatique'),
   {'entity': UNH_ENTITY_ID}
) }}

{# ================= EXPIRATION ================= #}
{{ fields.datetimeField(
   'expire',
   item.fields['expire'],
   __('Date d’expiration'),
   {'helper': __('Vide = licence permanente')}
) }}

{# ================= COMMENTAIRE ================= #}
{{ fields.textareaField(
   'comment',
   item.fields['comment'],
   __('Observations institutionnelles'),
   {'rows': 3}
) }}

{% if params['withtemplate'] == 1 %}
   {{ fields.hiddenField('withtemplate', '1') }}
{% endif %}

{% endblock %}
