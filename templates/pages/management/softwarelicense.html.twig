{% extends "generic_show_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set params = params ?? [] %}

{# ID entité UNH #}
{% set UNH_ENTITY_ID = 3 %}

{% block form_fields %}

<input type="hidden" name="entities_id" value="{{ UNH_ENTITY_ID }}"/>

<div class="alert alert-info mb-3">
   <strong>Université Nouveaux Horizons</strong><br>
   Gestion institutionnelle des licences logicielles
</div>

{# ================= LOGICIEL ================= #}
{% if item.fields['id'] > 0 %}

   <input type="hidden" name="softwares_id" value="{{ item.fields['softwares_id'] }}" />

   {% set software_link %}
      <a href="{{ call('Software::getFormURLWithID', [item.fields['softwares_id']]) }}">
         {{ call('Dropdown::getDropdownName', ['glpi_softwares', item.fields['softwares_id']]) }}
      </a>
   {% endset %}

   {{ fields.field('software', software_link, __('Logiciel')) }}

{% else %}

   {{ fields.dropdownField(
      'Software',
      'softwares_id',
      item.fields['softwares_id'],
      __('Logiciel'),
      {
         'entity': UNH_ENTITY_ID,
         'condition': {'is_deleted': 0},
         'on_change': 'this.form.submit()'
      }
   ) }}

{% endif %}

{{ fields.nullField() }}

{# ================= TYPE DE LICENCE ================= #}
{{ fields.dropdownField(
   'SoftwareLicenseType',
   'softwarelicensetypes_id',
   item.fields['softwarelicensetypes_id'],
   __('Type de licence'),
   {'entity': UNH_ENTITY_ID}
) }}

{# ================= FOURNISSEUR ================= #}
{{ fields.dropdownField(
   'Supplier',
   'suppliers_id',
   item.fields['suppliers_id'],
   __('Fournisseur'),
   {'entity': UNH_ENTITY_ID}
) }}

{# ================= LOCALISATION ================= #}
{{ fields.dropdownField(
   'Location',
   'locations_id',
   item.fields['locations_id'],
   __('Faculté / Service'),
   {'entity': UNH_ENTITY_ID}
) }}

{{ parent() }}
{% endblock %}

{% block more_fields %}

{# ================= VERSION UTILISÉE ================= #}
