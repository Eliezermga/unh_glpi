{#
 # ---------------------------------------------------------------------
 # Formulaire FINAL : Université Nouveaux Horizons (UNH)
 # Module : Gestion des Licences Logicielles
 # ---------------------------------------------------------------------
 #}

{% extends "generic_show_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set params = params ?? [] %}

{% block form_fields %}
   {# Bannière institutionnelle UNH #}
   <div class="alert alert-info text-center shadow-sm" style="border-left: 5px solid #003366; background-color: #f0f4f8; color: #003366;">
      <h4 class="mb-0" style="font-weight: bold;"><i class="fas fa-university"></i> UNIVERSITÉ NOUVEAUX HORIZONS</h4>
      <small class="text-uppercase fw-bold">{{ __('Système de Gestion des Actifs Numériques', 'management') }}</small>
   </div>

   {{ fields.dropdownField(
      __('Ressource Logicielle', 'management'),
      'softwares_id',
      item.fields['softwares_id'],
      "Software"|itemtype_name,
      {
         'entity': item.fields['entities_id'],
         'condition': {'is_template': 0, 'is_deleted': 0},
         'on_change': 'this.form.submit()'
      }
   ) }}

   {{ fields.nullField() }}
   {{ parent() }}
{% endblock %}

{% block more_fields %}
   {# --- SECTION 1 : DONNÉES DE LICENCE --- #}
   <h5 class="mt-4 pb-1" style="color: #003366; border-bottom: 2px solid #003366;">
      <i class="fas fa-info-circle"></i> {{ __('Détails de la Licence', 'management') }}
   </h5>

   {{ fields.field('softwareversions_id_use', null, __('Software version use', 'management')) }}
   {{ fields.field('softwareversions_id_buy', null, __('Software version buy', 'management')) }}

   {% set quota_html %}
      <div class="mt-1">
         <span class="badge bg-info"><i class="fas fa-info-circle"></i> {{ __('Vérification UNH en cours', 'management') }}</span>
      </div>
   {% endset %}

   {{ fields.dropdownNumberField('number', item.fields['number'], __('Quantité autorisée', 'management'), {
      'min': -1, 
      'max': 10000, 
      'step': 1,
      'toadd': {'-1': __('Licence Campus UNH', 'management')},
      'add_field_html': quota_html
   }) }}

   {{ fields.datetimeField('expire', item.fields['expire'], __('Date d\'expiration', 'management')) }}

   {# --- SECTION 2 : CHAMPS INSTITUTIONNELS UNH --- #}
   <div class="mt-5 p-4 border rounded shadow-sm" style="background-color: #ffffff; border: 1px solid #dee2e6 !important;">
      <h5 class="mb-4" style="color: #d9534f; font-weight: bold; border-bottom: 1px solid #eee; padding-bottom: 10px;">
         <i class="fas fa-building"></i> {{ __('Informations Institutionnelles UNH', 'management') }}
      </h5>

      <style>
         .unh-field-container .row { margin-bottom: 15px; }
         .unh-field-container label { font-weight: 600 !important; color: #333 !important; }
         .unh-field-container input, .unh-field-container textarea { border: 1px solid #adb5bd !important; }
      </style>

      <div class="unh-field-container">
         {{ fields.textField('faculte_service', item.fields['faculte_service'], __('faculte_service', 'management')) }}
         {{ fields.textField('responsable_it', item.fields['responsable_it'], __('responsable_it', 'management')) }}
         {{ fields.textField('service_informatique', item.fields['service_informatique'], __('service_informatique', 'management')) }}
         {{ fields.textField('version_unh_utilisee', item.fields['version_unh_utilisee'], __('version_unh_utilisee', 'management')) }}
         {{ fields.textField('version_unh_achetee', item.fields['version_unh_achetee'], __('version_unh_achetee', 'management')) }}
         {{ fields.textareaField('observations_institutionnelles', item.fields['observations_institutionnelles'], __('observations_institutionnelles', 'management')) }}
      </div>
   </div>

   {% if params['withtemplate'] == 1 %}
      {{ fields.hiddenField('withtemplate', '1') }}
   {% endif %}
{% endblock %}