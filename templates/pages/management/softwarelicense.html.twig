{#
 # ---------------------------------------------------------------------
 # Formulaire FINAL : Université Nouveaux Horizons (UNH)
 # Version : Conforme à la documentation technique UNH (Champs BD inclus)
 # ---------------------------------------------------------------------
 #}

{% extends "generic_show_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set params  = params ?? [] %}

{% block form_fields %}
   {# Bannière institutionnelle UNH #}
   <div class="alert alert-info text-center shadow-sm" style="border-left: 5px solid #0056b3; background-color: #f8f9fa;">
      <h4 class="mb-0" style="color: #0056b3;"><i class="fas fa-university"></i> UNIVERSITÉ NOUVEAUX HORIZONS</h4>
      <small class="text-uppercase fw-bold">Système de Gestion des Actifs Numériques</small>
   </div>

   {{ fields.dropdownField(
      'Ressource Logicielle',
      'softwares_id',
      item.fields['softwares_id'],
      "Software"|itemtype_name,
      {
         'entity': item.fields['entities_id'],
         'condition': {
            'is_template': 0,
            'is_deleted': 0,
         },
         'on_change': 'this.form.submit()'
      }
   ) }}

   {{ fields.nullField() }}

   {{ parent() }}
{% endblock %}

{% block more_fields %}
   {# --- SECTION 1 : DONNÉES DE LICENCE CLASSIQUES --- #}
   <h5 class="mt-2 text-secondary border-bottom pb-1">
      <i class="fas fa-info-circle"></i> Détails de la Licence
   </h5>

   {% set field_use %}
      {% do call('SoftwareVersion::dropdownForOneSoftware', [{
         'name': 'softwareversions_id_use',
         'softwares_id': item.fields['softwares_id'],
         'value': item.fields['softwareversions_id_use'],
         'width': '100%',
      }]) %}
   {% endset %}
   {{ fields.field('softwareversions_id_use', field_use, 'Version installée') }}

   {% set field_buy %}
      {% do call('SoftwareVersion::dropdownForOneSoftware', [{
      'name': 'softwareversions_id_buy',
      'softwares_id': item.fields['softwares_id'],
      'value': item.fields['softwareversions_id_buy'],
      'width': '100%',
      }]) %}
   {% endset %}
   {{ fields.field('softwareversions_id_buy', field_buy, 'Version acquise (Contrat)') }}

   {% set validity_msg = null %}
   {% if item_type == 'SoftwareLicense' %}
      {% set validity_msg %}
         <div class="mt-1">
            {% if item.fields['is_valid'] %}
               <span class="badge bg-success"><i class="fas fa-check"></i> Valide</span>
            {% elseif not item.fields['is_valid'] and item.fields['allow_overquota'] %}
               <span class="badge bg-warning text-dark"><i class="fas fa-exclamation"></i> Over-Quota</span>
            {% else %}
               <span class="badge bg-danger"><i class="fas fa-times"></i> Invalide</span>
            {% endif %}
         </div>
      {% endset %}
   {% endif %}

   {{ fields.dropdownNumberField('number', item.fields['number'], 'Quantité autorisée', {
      'min': 1,
      'max': 10000,
      'step': 1,
      'toadd': {'-1': 'Licence Campus UNH'},
      'add_field_html': validity_msg
   }) }}

   {{ fields.datetimeField('expire', item.fields['expire'], 'Date d\'expiration', {
      'helper': 'Planification du budget annuel UNH.'
   }) }}

   {# --- SECTION 2 : CHAMPS SPÉCIFIQUES DOCUMENTATION UNH --- #}
   <hr class="my-4">
   <div class="p-3 mb-2 bg-light border rounded">
      <h5 class="text-primary mb-3">
         <i class="fas fa-building"></i> Informations Institutionnelles UNH
      </h5>

      {{ fields.textField('faculte_service', item.fields['faculte_service'], 'Faculté / Service concerné') }}

      {{ fields.textField('responsable_it', item.fields['responsable_it'], 'Responsable IT du service') }}

      {{ fields.textField('service_informatique', item.fields['service_informatique'], 'Service Informatique de rattachement') }}

      {{ fields.textField('version_unh_utilisee', item.fields['version_unh_utilisee'], 'Version réellement utilisée à UNH') }}

      {{ fields.textField('version_unh_achetee', item.fields['version_unh_achetee'], 'Version achetée (Contrat UNH)') }}

      {{ fields.textareaField('observations_institutionnelles', item.fields['observations_institutionnelles'], 'Observations institutionnelles') }}
   </div>

   {% if params['withtemplate'] == 1 %}
      {{ fields.hiddenField('withtemplate', '1') }}
   {% endif %}
{% endblock %}