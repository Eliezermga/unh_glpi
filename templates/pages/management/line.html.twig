{% extends "generic_show_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block more_fields %}

<h2 style="color:#b30000">Ligne – Université Nouveaux Horizons</h2>

{{ fields.textField(
   'name',
   item.fields['name'],
   __('Intitulé de la ligne'),
   {
      'placeholder': 'Ex: Ligne académique L1 Informatique'
   }
) }}

{{ fields.textField(
   'code',
   item.fields['code'],
   __('Code de la ligne'),
   {
      'placeholder': 'UNH-LIG-2025'
   }
) }}

{{ fields.dropdownArrayField(
   'line_type',
   item.fields['line_type'],
   {
      1: 'Académique',
      2: 'Administrative',
      3: 'Pédagogique',
      4: 'Organisationnelle'
   },
   __('Type de ligne')
) }}

{{ fields.textField(
   'faculty',
   item.fields['faculty'],
   __('Faculté concernée'),
   {
      'placeholder': 'Faculté des Sciences Informatiques'
   }
) }}

{{ fields.textField(
   'academic_year',
   item.fields['academic_year'],
   __('Année académique'),
   {
      'placeholder': '2024 – 2025'
   }
) }}

{{ fields.textField(
   'responsible',
   item.fields['responsible'],
   __('Responsable UNH'),
   {
      'placeholder': 'Nom du responsable'
   }
) }}

{{ fields.textareaField(
   'comment',
   item.fields['comment'],
   __('Description / Observations')
) }}

{% endblock %}
