{# Template: Gestion des alertes #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }}</title>
    <link rel="stylesheet" href="{{ 'plugins/unh_assets/css/unh_assets.css'|glpi_asset }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f5f5f5;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }
        .alerts-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
    </style>
</head>
<body>
<div class="alerts-wrapper">
    {# En-tête #}
    <div class="unh-assets-header">
        <h1>
            <i class="fas fa-bell"></i>
            {{ page_title }}
        </h1>
    </div>

    {# Résumé des alertes #}
    <div class="unh-stats-grid">
        <div class="unh-stat-card">
            <div class="unh-stat-label">Total d'alertes</div>
            <div class="unh-stat-value">
                {{ alerts_by_severity.critical + alerts_by_severity.warning + alerts_by_severity.info }}
            </div>
            <i class="fas fa-bell unh-stat-icon"></i>
        </div>

        <div class="unh-stat-card">
            <div class="unh-stat-label">Critiques</div>
            <div class="unh-stat-value" style="color: #DC3545;">{{ alerts_by_severity.critical }}</div>
            <i class="fas fa-exclamation-circle unh-stat-icon" style="color: #DC3545;"></i>
        </div>

        <div class="unh-stat-card">
            <div class="unh-stat-label">Avertissements</div>
            <div class="unh-stat-value" style="color: #FFD700;">{{ alerts_by_severity.warning }}</div>
            <i class="fas fa-exclamation-triangle unh-stat-icon" style="color: #FFD700;"></i>
        </div>

        <div class="unh-stat-card">
            <div class="unh-stat-label">Informations</div>
            <div class="unh-stat-value" style="color: #0BA0D0;">{{ alerts_by_severity.info }}</div>
            <i class="fas fa-info-circle unh-stat-icon" style="color: #0BA0D0;"></i>
        </div>
    </div>

    {# Liste des alertes #}
    <div class="unh-assets-container">
        {% if unresolved_alerts|length > 0 %}
            {% for alert in unresolved_alerts %}
            <div style="border: 1px solid #E9ECEF; border-radius: 4px; padding: 16px; margin-bottom: 12px; border-left: 4px solid {% if alert.alert_level == 'critical' %}#DC3545{% elseif alert.alert_level == 'warning' %}#FFD700{% else %}#0BA0D0{% endif %};">
                <div style="display: flex; align-items: start; gap: 12px;">
                    <div style="font-size: 20px; margin-top: 2px; color: {% if alert.alert_level == 'critical' %}#DC3545{% elseif alert.alert_level == 'warning' %}#FFD700{% else %}#0BA0D0{% endif %};">
                        {% if alert.alert_level == 'critical' %}
                            <i class="fas fa-exclamation-circle"></i>
                        {% elseif alert.alert_level == 'warning' %}
                            <i class="fas fa-exclamation-triangle"></i>
                        {% else %}
                            <i class="fas fa-info-circle"></i>
                        {% endif %}
                    </div>

                    <div style="flex-grow: 1;">
                        <h3 style="margin: 0 0 6px 0; font-size: 14px;">
                            {{ alert.equipment_name }}
                            <span class="unh-badge" style="background-color: {% if alert.alert_level == 'critical' %}rgba(220, 53, 69, 0.1); color: #DC3545; border-color: #DC3545;{% elseif alert.alert_level == 'warning' %}rgba(255, 193, 7, 0.1); color: #FFD700; border-color: #FFD700;{% else %}rgba(11, 160, 208, 0.1); color: #0BA0D0; border-color: #0BA0D0;{% endif %} margin-left: 8px;">
                                {{ alert.alert_level|upper }}
                            </span>
                        </h3>
                        
                        <p style="margin: 6px 0; font-size: 13px; color: #333;">
                            <strong>Type:</strong> {{ alert.alert_type|replace('_', ' ')|title }}
                        </p>

                        <p style="margin: 6px 0; font-size: 13px; color: #666;">
                            {{ alert.message }}
                        </p>

                        <div style="font-size: 11px; color: #999; display: flex; gap: 15px; flex-wrap: wrap; margin-top: 8px;">
                            <span><i class="fas fa-clock"></i> Créé: {{ alert.date_creation|date('d/m/Y H:i') }}</span>
                            {% if alert.type_name %}
                            <span><i class="fas fa-tag"></i> Type: {{ alert.type_name }}</span>
                            {% endif %}
                        </div>
                    </div>

                    <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end;">
                        <a href="?action=view&id={{ alert.equipments_id }}" class="unh-btn unh-btn-sm unh-btn-primary">
                            <i class="fas fa-eye"></i> Voir
                        </a>
                        {% if is_admin %}
                            <button class="unh-btn unh-btn-sm unh-btn-success" onclick="resolveAlert({{ alert.id }}, '{{ csrf_token }}')">
                                <i class="fas fa-check"></i> Résoudre
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        {% else %}
            <div style="text-align: center; padding: 40px; color: #6C757D;">
                <i class="fas fa-check-circle" style="font-size: 48px; display: block; margin-bottom: 15px; color: #28A745;"></i>
                <p style="font-size: 14px; margin: 0;">Aucune alerte non résolue 🎉</p>
                <p style="font-size: 12px; margin: 8px 0 0 0; color: #999;">Le système fonctionne correctement.</p>
            </div>
        {% endif %}
    </div>

    {# Actions #}
    <div class="unh-assets-container" style="text-align: center;">
        <a href="?action=dashboard" class="unh-btn unh-btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour au tableau de bord
        </a>
    </div>
</div>

<script>
function resolveAlert(alertId, csrfToken) {
    if (confirm('Êtes-vous sûr de vouloir résoudre cette alerte?')) {
        // Appel AJAX pour résoudre l'alerte avec token CSRF
        fetch('plugins/unh_assets/front/api.php', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                action: 'resolve_alert',
                alert_id: alertId,
                _glpi_csrf_token: csrfToken
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Erreur lors de la résolution de l\'alerte: ' + (data.error || 'Erreur inconnue'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Erreur réseau lors de la résolution de l\'alerte');
        });
    }
}
</script>
</body>
</html>
