{# Template: Statistiques du parc #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }}</title>
    <link rel="stylesheet" href="{{ 'plugins/unh_assets/css/unh_assets.css'|glpi_asset }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f5f5f5;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }
        .stats-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
    </style>
</head>
<body>
<div class="stats-wrapper">
    {# En-tête #}
    <div class="unh-assets-header">
        <h1>
            <i class="fas fa-chart-bar"></i>
            {{ page_title }}
        </h1>
    </div>

    {# KPIs principaux #}
    <div class="unh-stats-grid">
        <div class="unh-stat-card">
            <div class="unh-stat-label">Total d'équipements</div>
            <div class="unh-stat-value">{{ stats.total }}</div>
            <i class="fas fa-cube unh-stat-icon"></i>
        </div>

        <div class="unh-stat-card">
            <div class="unh-stat-label">Opérationnels</div>
            <div class="unh-stat-value" style="color: #28A745;">
                {{ stats.operational }}
                <small style="font-size: 12px; font-weight: normal;">
                    ({{ ((stats.operational / stats.total * 100) if stats.total > 0 else 0)|round(1) }}%)
                </small>
            </div>
            <i class="fas fa-check-circle unh-stat-icon" style="color: #28A745;"></i>
        </div>

        <div class="unh-stat-card">
            <div class="unh-stat-label">En maintenance</div>
            <div class="unh-stat-value" style="color: #FFD700;">
                {{ stats.maintenance }}
                <small style="font-size: 12px; font-weight: normal;">
                    ({{ ((stats.maintenance / stats.total * 100) if stats.total > 0 else 0)|round(1) }}%)
                </small>
            </div>
            <i class="fas fa-tools unh-stat-icon" style="color: #FFD700;"></i>
        </div>

        <div class="unh-stat-card">
            <div class="unh-stat-label">Hors service</div>
            <div class="unh-stat-value" style="color: #DC3545;">
                {{ stats.out_of_service }}
                <small style="font-size: 12px; font-weight: normal;">
                    ({{ ((stats.out_of_service / stats.total * 100) if stats.total > 0 else 0)|round(1) }}%)
                </small>
            </div>
            <i class="fas fa-times-circle unh-stat-icon" style="color: #DC3545;"></i>
        </div>

        <div class="unh-stat-card alternate">
            <div class="unh-stat-label">Taux d'opérabilité</div>
            <div class="unh-stat-value">
                {{ ((stats.operational / stats.total * 100) if stats.total > 0 else 0)|round(1) }}%
            </div>
            <i class="fas fa-percentage unh-stat-icon"></i>
        </div>
    </div>

    {# Répartition par type #}
    <div class="unh-assets-container">
        <div class="unh-assets-header">
            <h2 style="margin: 0; font-size: 16px;">
                <i class="fas fa-chart-pie"></i>
                Répartition par type d'équipement
            </h2>
        </div>

        {% if stats.by_type|length > 0 %}
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                {% for type_name, count in stats.by_type %}
                <div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="font-weight: 500; font-size: 13px;">{{ type_name }}</span>
                        <span style="font-weight: 600; color: #0BA0D0;">{{ count }}</span>
                    </div>
                    <div style="background-color: #E9ECEF; border-radius: 3px; height: 24px; overflow: hidden; display: flex; align-items: center;">
                        <div style="background: linear-gradient(90deg, #0BA0D0 0%, #3AA3E3 100%); height: 100%; width: {{ (count / stats.total * 100)|round }}%; display: flex; align-items: center; justify-content: center;">
                            {% if (count / stats.total * 100) > 15 %}
                                <span style="color: white; font-size: 11px; font-weight: 600;">{{ (count / stats.total * 100)|round(1) }}%</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <p style="text-align: center; color: #6C757D;">Aucune données disponible</p>
        {% endif %}
    </div>

    {# Répartition par bâtiment #}
    <div class="unh-assets-container">
        <div class="unh-assets-header">
            <h2 style="margin: 0; font-size: 16px;">
                <i class="fas fa-building"></i>
                Répartition par bâtiment
            </h2>
        </div>

        {% if stats.by_building|length > 0 %}
            <div style="overflow-x: auto;">
                <table class="unh-equipment-table">
                    <thead>
                        <tr>
                            <th>Bâtiment</th>
                            <th style="text-align: right;">Nombre d'équipements</th>
                            <th style="text-align: right;">Pourcentage</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for building_name, count in stats.by_building %}
                        <tr>
                            <td>
                                <strong>{{ building_name }}</strong>
                            </td>
                            <td style="text-align: right;">
                                <span style="font-weight: 600; color: #0BA0D0;">{{ count }}</span>
                            </td>
                            <td style="text-align: right;">
                                {{ (count / stats.total * 100)|round(1) }}%
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p style="text-align: center; color: #6C757D;">Aucune données disponible</p>
        {% endif %}
    </div>

    {# Graphiques de synthèse #}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
        {# Distribution des états #}
        <div class="unh-assets-container">
            <div class="unh-assets-header">
                <h2 style="margin: 0; font-size: 16px;">
                    <i class="fas fa-doughnut-chart"></i>
                    Distribution des états
                </h2>
            </div>

            <div style="text-align: center;">
                <svg viewBox="0 0 120 120" style="width: 150px; height: 150px; margin: 0 auto;">
                    <!-- Opérationnels -->
                    {% set operational_percent = (stats.operational / stats.total * 100)|round if stats.total > 0 else 0 %}
                    {% set maintenance_percent = (stats.maintenance / stats.total * 100)|round if stats.total > 0 else 0 %}
                    {% set out_percent = (stats.out_of_service / stats.total * 100)|round if stats.total > 0 else 0 %}
                    
                    <circle cx="60" cy="60" r="45" fill="none" stroke="#E9ECEF" stroke-width="30"/>
                    <circle cx="60" cy="60" r="45" fill="none" stroke="#28A745" stroke-width="30" 
                            stroke-dasharray="{{ operational_percent * 2.83 }} 282.74" transform="rotate(-90 60 60)"/>
                </svg>

                <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 15px;">
                    <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <span style="width: 12px; height: 12px; background-color: #28A745; border-radius: 2px;"></span>
                        <span style="font-size: 12px;">Opérationnel: {{ operational_percent }}%</span>
                    </div>
                    <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <span style="width: 12px; height: 12px; background-color: #FFD700; border-radius: 2px;"></span>
                        <span style="font-size: 12px;">Maintenance: {{ maintenance_percent }}%</span>
                    </div>
                    <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <span style="width: 12px; height: 12px; background-color: #DC3545; border-radius: 2px;"></span>
                        <span style="font-size: 12px;">Hors service: {{ out_percent }}%</span>
                    </div>
                </div>
            </div>
        </div>

        {# KPI d'efficacité #}
        <div class="unh-assets-container">
            <div class="unh-assets-header">
                <h2 style="margin: 0; font-size: 16px;">
                    <i class="fas fa-tachometer-alt"></i>
                    Indicateurs d'efficacité
                </h2>
            </div>

            <div style="display: flex; flex-direction: column; gap: 15px;">
                <div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                        <span style="font-size: 12px; font-weight: 500;">Disponibilité</span>
                        <strong>{{ ((stats.operational / stats.total * 100) if stats.total > 0 else 0)|round(1) }}%</strong>
                    </div>
                    <div style="background-color: #E9ECEF; border-radius: 3px; height: 8px;">
                        <div style="background-color: #28A745; height: 100%; width: {{ ((stats.operational / stats.total * 100) if stats.total > 0 else 0)|round }}%; border-radius: 3px;"></div>
                    </div>
                </div>

                <div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                        <span style="font-size: 12px; font-weight: 500;">En maintenance</span>
                        <strong>{{ ((stats.maintenance / stats.total * 100) if stats.total > 0 else 0)|round(1) }}%</strong>
                    </div>
                    <div style="background-color: #E9ECEF; border-radius: 3px; height: 8px;">
                        <div style="background-color: #FFD700; height: 100%; width: {{ ((stats.maintenance / stats.total * 100) if stats.total > 0 else 0)|round }}%; border-radius: 3px;"></div>
                    </div>
                </div>

                <div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                        <span style="font-size: 12px; font-weight: 500;">Hors service</span>
                        <strong>{{ ((stats.out_of_service / stats.total * 100) if stats.total > 0 else 0)|round(1) }}%</strong>
                    </div>
                    <div style="background-color: #E9ECEF; border-radius: 3px; height: 8px;">
                        <div style="background-color: #DC3545; height: 100%; width: {{ ((stats.out_of_service / stats.total * 100) if stats.total > 0 else 0)|round }}%; border-radius: 3px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Actions #}
    <div class="unh-assets-container" style="text-align: center;">
        <a href="?action=dashboard" class="unh-btn unh-btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour au tableau de bord
        </a>
        <button class="unh-btn unh-btn-primary" style="margin-left: 10px;" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimer
        </button>
    </div>
</div>
</body>
</html>
