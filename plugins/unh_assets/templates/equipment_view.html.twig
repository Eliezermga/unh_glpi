{# Template: Détails d'un équipement #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }}</title>
    <link rel="stylesheet" href="{{ 'plugins/unh_assets/css/unh_assets.css'|glpi_asset }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f5f5f5;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }
        .view-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
    </style>
</head>
<body>
<div class="view-wrapper">
    {# En-tête #}
    <div class="unh-assets-header">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <h1>
                <i class="fas fa-cube"></i>
                {{ equipment.name }}
            </h1>
            {% if equipment.is_alert %}
                <span class="unh-badge unh-badge-alert-critical" style="font-size: 14px; padding: 8px 12px;">
                    <i class="fas fa-exclamation-circle"></i> EN ALERTE
                </span>
            {% endif %}
        </div>
    </div>

    {# Alertes non résolues #}
    {% if alerts|length > 0 %}
        {% for alert in alerts %}
            {% if not alert.is_resolved %}
            <div class="unh-alert unh-alert-critical">
                <i class="fas fa-exclamation-circle unh-alert-icon"></i>
                <div class="unh-alert-content">
                    <strong>Alerte: {{ alert.alert_type|replace('_', ' ')|title }}</strong>
                    <p style="margin: 4px 0 0 0; font-size: 12px;">
                        {{ alert.message }}
                    </p>
                    <small style="color: #999;">Créé le: {{ alert.date_creation|date('d/m/Y H:i') }}</small>
                </div>
            </div>
            {% endif %}
        {% endfor %}
    {% endif %}

    {# Informations principales #}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 20px;">
        <div class="unh-assets-container">
            <div class="unh-assets-header">
                <h2 style="margin: 0; font-size: 16px;">
                    <i class="fas fa-info-circle"></i>
                    Informations générale
                </h2>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Nom</span>
                    <span class="unh-equipment-info-value">{{ equipment.name }}</span>
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Type</span>
                    <span class="unh-equipment-info-value">{{ equipment.type_name }}</span>
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Marque</span>
                    <span class="unh-equipment-info-value">{{ equipment.brand|default('-') }}</span>
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Modèle</span>
                    <span class="unh-equipment-info-value">{{ equipment.model|default('-') }}</span>
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Numéro de série</span>
                    <span class="unh-equipment-info-value">
                        <code style="background-color: #F5F5F5; padding: 4px 8px; border-radius: 3px; font-size: 11px;">
                            {{ equipment.serial_number|default('-') }}
                        </code>
                    </span>
                </div>
            </div>
        </div>

        <div class="unh-assets-container">
            <div class="unh-assets-header">
                <h2 style="margin: 0; font-size: 16px;">
                    <i class="fas fa-map-marker-alt"></i>
                    Localisation
                </h2>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Bâtiment</span>
                    <span class="unh-equipment-info-value">{{ equipment.building_name|default('-') }}</span>
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Salle/Bureau</span>
                    <span class="unh-equipment-info-value">{{ equipment.room_name|default('-') }}</span>
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">État</span>
                    {% if equipment.status == 'operational' %}
                        <span class="unh-badge unh-badge-operational">
                            <i class="fas fa-check-circle"></i> Opérationnel
                        </span>
                    {% elseif equipment.status == 'maintenance' %}
                        <span class="unh-badge unh-badge-maintenance">
                            <i class="fas fa-tools"></i> En maintenance
                        </span>
                    {% else %}
                        <span class="unh-badge unh-badge-out-of-service">
                            <i class="fas fa-times-circle"></i> Hors service
                        </span>
                    {% endif %}
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Utilisateur assigné</span>
                    <span class="unh-equipment-info-value">{{ equipment.assigned_user|default('-') }}</span>
                </div>
            </div>
        </div>

        <div class="unh-assets-container">
            <div class="unh-assets-header">
                <h2 style="margin: 0; font-size: 16px;">
                    <i class="fas fa-calendar-alt"></i>
                    Dates importantes
                </h2>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Date d'achat</span>
                    <span class="unh-equipment-info-value">
                        {% if equipment.purchase_date %}
                            {{ equipment.purchase_date|date('d/m/Y') }}
                        {% else %}
                            -
                        {% endif %}
                    </span>
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Fin de garantie</span>
                    <span class="unh-equipment-info-value">
                        {% if equipment.warranty_expiration %}
                            {{ equipment.warranty_expiration|date('d/m/Y') }}
                        {% else %}
                            -
                        {% endif %}
                    </span>
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">Dernière maintenance</span>
                    <span class="unh-equipment-info-value">
                        {% if equipment.last_maintenance %}
                            {{ equipment.last_maintenance|date('d/m/Y') }}
                        {% else %}
                            Aucune
                        {% endif %}
                    </span>
                </div>

                <div class="unh-equipment-info-item">
                    <span class="unh-equipment-info-label">État du matériel</span>
                    <span class="unh-equipment-info-value">{{ equipment.condition|title }}</span>
                </div>
            </div>
        </div>
    </div>

    {# Commentaires #}
    {% if equipment.comments %}
    <div class="unh-assets-container">
        <div class="unh-assets-header">
            <h2 style="margin: 0; font-size: 16px;">
                <i class="fas fa-comment"></i>
                Commentaires
            </h2>
        </div>
        <p style="margin: 0; font-size: 13px; color: #333; line-height: 1.5;">
            {{ equipment.comments }}
        </p>
    </div>
    {% endif %}

    {# Historique des alertes #}
    {% if alerts|length > 0 %}
    <div class="unh-assets-container">
        <div class="unh-assets-header">
            <h2 style="margin: 0; font-size: 16px;">
                <i class="fas fa-history"></i>
                Historique des alertes
            </h2>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px;">
            {% for alert in alerts %}
            <div style="border: 1px solid #E9ECEF; border-radius: 4px; padding: 12px; background-color: {% if alert.is_resolved %}#F5F5F5{% else %}rgba(220, 53, 69, 0.05){% endif %};">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                    <div>
                        <strong>{{ alert.alert_type|replace('_', ' ')|title }}</strong>
                        <span class="unh-badge unh-badge-alert-{% if alert.alert_level == 'critical' %}critical{% elseif alert.alert_level == 'warning' %}warning{% else %}info{% endif %}" style="margin-left: 8px;">
                            {{ alert.alert_level|upper }}
                        </span>
                    </div>
                    {% if alert.is_resolved %}
                        <span class="unh-badge unh-badge-operational" style="font-size: 11px;">✓ Résolu</span>
                    {% endif %}
                </div>

                <p style="margin: 6px 0; font-size: 12px; color: #333;">
                    {{ alert.message }}
                </p>

                <div style="font-size: 11px; color: #999; display: flex; gap: 15px;">
                    <span>Créé: {{ alert.date_creation|date('d/m/Y H:i') }}</span>
                    {% if alert.is_resolved %}
                        <span>Résolu: {{ alert.resolved_at|date('d/m/Y H:i') }}</span>
                        {% if alert.resolution_notes %}
                        <span style="color: #666;">Notes: {{ alert.resolution_notes }}</span>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# Journal de maintenance #}
    {% if maintenance_logs|length > 0 %}
    <div class="unh-assets-container">
        <div class="unh-assets-header">
            <h2 style="margin: 0; font-size: 16px;">
                <i class="fas fa-wrench"></i>
                Journal de maintenance
            </h2>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px;">
            {% for log in maintenance_logs %}
            <div style="border: 1px solid #E9ECEF; border-radius: 4px; padding: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                    <strong>{{ log.maintenance_type|title }}</strong>
                    <span class="unh-badge unh-badge-operational">{{ log.date_creation|date('d/m/Y') }}</span>
                </div>

                {% if log.description %}
                <p style="margin: 6px 0; font-size: 12px; color: #333;">
                    {{ log.description }}
                </p>
                {% endif %}

                <div style="font-size: 11px; color: #999; display: flex; gap: 15px; flex-wrap: wrap;">
                    {% if log.technician_name %}
                    <span>Technicien: {{ log.technician_name }}</span>
                    {% endif %}
                    {% if log.duration_hours %}
                    <span>Durée: {{ log.duration_hours }}h</span>
                    {% endif %}
                    {% if log.cost %}
                    <span>Coût: {{ log.cost|number_format(2, ',', ' ') }} €</span>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# Actions #}
    <div class="unh-assets-container" style="text-align: center;">
        <a href="?action=list" class="unh-btn unh-btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>
        {% if is_admin %}
            <a href="?action=edit&id={{ equipment.id }}" class="unh-btn unh-btn-primary" style="margin-left: 10px;">
                <i class="fas fa-edit"></i> Modifier
            </a>
        {% endif %}
    </div>
</div>
</body>
</html>
